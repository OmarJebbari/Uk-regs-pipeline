# =============================================================================
# UK Regs Pipeline — environment configuration (12-factor)
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# =============================================================================

# ---- General ----
ENV=dev
DEBUG=true

# ---- Postgres + pgvector (matches infra/compose/docker-compose.yml) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ukregs
POSTGRES_USER=ukregs
POSTGRES_PASSWORD=ukregs

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ---- Object storage (MinIO local; or S3 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uk-regs
S3_REGION=us-east-1

# ---- LLM provider ----
# Provider abstraction lives in packages/extraction/.../llm/client.py.
LLM_PROVIDER=openai
OPENAI_API_KEY=              # <-- set this to use LLM extraction + figure understanding
OPENAI_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=60.0

# ---- Embeddings ----
EMBEDDING_MODEL=text-embedding-3-small

# ---- Pipeline behaviour ----
CONFIDENCE_THRESHOLD=0.85    # below this -> human review
RECONCILIATION_TOP_K=5

# ---- API security ----
# Set API_KEY to gate mutating endpoints (POST /changes/.../review).
# When unset, the API runs in open dev mode (all endpoints allowed).
API_KEY=

# ---- Observability ----
# Structured logging: "json" (prod) or "console" (dev, pretty colors)
LOG_FORMAT=console
LOG_LEVEL=INFO

# OpenTelemetry tracing — leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=uk-regs-api

# Langfuse LLM observability — leave empty to disable
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---- Source monitoring (Phase 5-1) ----
# Where the monitor finds its watched sources (publisher to PDF manifests).
SOURCES_YAML=sources.yaml
# Backend: "mock" (in-memory, tests) | "auto" (Postgres if available).
UK_REGS_BACKEND=auto

# ---- Hybrid search (Phase 5-2) ----
# Reciprocal Rank Fusion smoothing constant (default 60, Cormack et al. 2009).
# Higher = more weight to rank position; lower = more democratic.
SEARCH_RRF_K=60
# How many candidates to pull from EACH leg (BM25 + vector) before fusion.
# Higher = better recall at the cost of latency. Must be >= top_k.
SEARCH_CANDIDATE_K=50
# Minimum fused score to include a result (0.0 = keep all; raises precision
# when set, e.g., 0.01 filters out docs that only barely matched one leg).
SEARCH_MIN_SCORE=0.0
