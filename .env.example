# =============================================================================
# UK Regs Pipeline — environment configuration (12-factor)
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# =============================================================================

# ---- General ----
ENV=dev
DEBUG=true

# ---- Postgres + pgvector (matches infra/compose/docker-compose.yml) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ukregs
POSTGRES_USER=ukregs
POSTGRES_PASSWORD=ukregs

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ---- Object storage (MinIO local; or S3 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uk-regs
S3_REGION=us-east-1

# ---- LLM provider ----
# Provider abstraction lives in packages/extraction/.../llm/client.py.
LLM_PROVIDER=openai
OPENAI_API_KEY=              # <-- set this to use LLM extraction + figure understanding
OPENAI_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=60.0

# ---- Embeddings ----
EMBEDDING_MODEL=text-embedding-3-small

# ---- Pipeline behaviour ----
CONFIDENCE_THRESHOLD=0.85    # below this -> human review
RECONCILIATION_TOP_K=5