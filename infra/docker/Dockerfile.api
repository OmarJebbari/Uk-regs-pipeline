# =============================================================================
# UK Regs Pipeline — FastAPI context-serving API
# =============================================================================
# Multi-stage build:
#   1. builder  — resolves the full uv workspace and compiles wheels
#   2. runtime  — slim image with only the installed venv + app source
#
# Build context MUST be the repo root:
#   docker build -f infra/docker/Dockerfile.api -t uk-regs-api:latest .
# =============================================================================
# syntax=docker/dockerfile:1.7

# ---------------------------------------------------------------------------- #
# Stage 1 — builder
# ---------------------------------------------------------------------------- #
FROM python:3.12-slim AS builder

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Build deps: uv + system libs needed by psycopg/lxml/pillow wheels.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libpq-dev \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

WORKDIR /app

# Cache deps separately from source: copy manifests first.
COPY pyproject.toml uv.lock* ./
COPY packages/        ./packages/
COPY pipelines/       ./pipelines/
COPY apps/            ./apps/

# Resolve + compile the entire workspace into /app/.venv
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# ---------------------------------------------------------------------------- #
# Stage 2 — runtime
# ---------------------------------------------------------------------------- #
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:${PATH}" \
    UK_REGS_API_HOST=0.0.0.0 \
    UK_REGS_API_PORT=8000

# Runtime system libs only (no build toolchain).
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpq5 curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 1001 ukregs \
 && useradd  --system --uid 1001 --gid ukregs --home-dir /app --shell /sbin/nologin ukregs

WORKDIR /app

# Copy the pre-built venv and the application source.
COPY --from=builder --chown=ukregs:ukregs /app/.venv ./venv
COPY --chown=ukregs:ukregs pyproject.toml uv.lock* ./
COPY --chown=ukregs:ukregs packages/  ./packages/
COPY --chown=ukregs:ukregs pipelines/ ./pipelines/
COPY --chown=ukregs:ukregs apps/      ./apps/
COPY --chown=ukregs:ukregs migrations/ ./migrations/
COPY --chown=ukregs:ukregs alembic.ini ./

USER ukregs

EXPOSE 8000

# Run migrations on boot, then launch uvicorn behind the venv.
CMD ["sh", "-c", "alembic upgrade head && uvicorn uk_regs_api.app:app --host 0.0.0.0 --port 8000 --workers 2"]

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:8000/health || exit 1