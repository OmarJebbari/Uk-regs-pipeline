# =============================================================================
# UK Regs Pipeline — ingest worker
# =============================================================================
# Packages the full uv workspace plus PDF/OCR system deps (poppler, tesseract).
# Runs as a one-shot CLI command:
#   docker run --rm uk-regs-worker:latest \
#       uk-regs-ingest ingest /pdfs/adb.pdf --title "ADB" --version 2026
#
# Build context MUST be the repo root:
#   docker build -f infra/docker/Dockerfile.worker -t uk-regs-worker:latest .
# =============================================================================
# syntax=docker/dockerfile:1.7

# ---------------------------------------------------------------------------- #
# Stage 1 — builder (shared with Dockerfile.api)
# ---------------------------------------------------------------------------- #
FROM python:3.12-slim AS builder

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libpq-dev \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock* ./
COPY packages/   ./packages/
COPY pipelines/  ./pipelines/
COPY apps/       ./apps/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# ---------------------------------------------------------------------------- #
# Stage 2 — runtime
# ---------------------------------------------------------------------------- #
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:${PATH}"

# PDF parsing + OCR runtime deps (pdfplumber needs poppler; tesseract for OCR).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        libpq5 libxml2 libxslt1.1 \
        poppler-utils \
        tesseract-ocr tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 1001 ukregs \
 && useradd  --system --uid 1001 --gid ukregs --home-dir /app --shell /sbin/nologin ukregs

WORKDIR /app

COPY --from=builder --chown=ukregs:ukregs /app/.venv ./venv
COPY --chown=ukregs:ukregs pyproject.toml uv.lock* ./
COPY --chown=ukregs:ukregs packages/   ./packages/
COPY --chown=ukregs:ukregs pipelines/  ./pipelines/
COPY --chown=ukregs:ukregs apps/       ./apps/
COPY --chown=ukregs:ukregs migrations/ ./migrations/
COPY --chown=ukregs:ukregs alembic.ini ./

# Default mount point for PDFs to ingest.
RUN mkdir -p /pdfs && chown ukregs:ukregs /pdfs
VOLUME ["/pdfs"]

USER ukregs

# Default: show help. Override CMD to run a real ingest.
ENTRYPOINT ["uk-regs-ingest"]
CMD ["--help"]