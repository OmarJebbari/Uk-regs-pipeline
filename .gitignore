# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.python-version

# ---- Virtual envs ----
.venv/
venv/
env/

# ---- Tool caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Env / secrets ----
.env
.env.*
!.env.example

# ---- IDE ----
.vscode/
.idea/
*.swp

# ---- Data (never commit PDFs / large files) ----
data/*.pdf
data/*.png
data/*.jpg
data/out/
!data/.gitkeep

# ---- Terraform (state/plans contain secrets — never commit) ----
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
*_override.tf
*_override.tf.json
# Secrets belong in TF_VAR_* env vars, never in tfvars. dev/prod are reviewed + safe to track.
*.tfvars
!dev.tfvars
!prod.tfvars

# ---- Backups & database dumps (docs/BACKUP-DR.md writes here) ----
backups/
*.dump
*.sql.gz
*.sqlite
*.sqlite3
*.db

# ---- Local source drop-folder (sources.yaml "local" fetcher) ----
incoming/

# ---- Logs ----
*.log
logs/

# ---- Private keys / certs ----
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# ---- Coverage extras ----
.coverage.*
coverage.xml

# ---- OS ----
.DS_Store
Thumbs.db